include README.md
include README.zh-CN.md
include CHANGELOG.md
include LICENSE
include NOTICE
include THIRD_PARTY_LICENSES.md
include CONTRIBUTING.md
include AGENTS.md
include pyproject.toml
include mkdocs.yml
include SECURITY.md
include CODE_OF_CONDUCT.md
include cli.py

recursive-include OpenVBSPP *.py py.typed
recursive-include OpenVBSPP/vendor *.py *.json *.vbs
recursive-include extras *.py *.json *.md *.vbs *.js
recursive-include examples *.vbs *.ps1 *.md
recursive-include packaging *.spec *.py
recursive-include tests *.py
recursive-include tools *.py *.ps1
recursive-include doc *.md *.docx
recursive-include dev-docs *.md
# Pattern-based on purpose: MANIFEST.in splits paths on spaces, so
# "include doc/OpenVBS spec.docx" would be read as two missing patterns.
# The language spec ships in the sdist; the internal planning essay does not.

prune venv
prune .vs
prune __pycache__

# Never ship compiled artefacts: they are machine- and Python-version-specific.
global-exclude *.pyc *.pyo *.pyd
