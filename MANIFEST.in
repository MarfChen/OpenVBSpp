include README.md
include README.zh-CN.md
include LICENSE
include NOTICE
include CONTRIBUTING.md
include AGENTS.md
include pyproject.toml

recursive-include OpenVBSPP *.py py.typed
recursive-include OpenVBSPP/vendor *.py *.json
recursive-include extras *.py *.json *.md *.vbs *.js
recursive-include examples *.vbs
recursive-include packaging *
recursive-include tests *.py
recursive-include tools *.py
recursive-include doc *.md *.docx

prune venv
prune .vs
prune __pycache__
